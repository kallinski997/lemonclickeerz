# GitHub Actions Workflow für automatischen APK Build
# 
# HINWEIS: Dieses Workflow ist als Referenz gedacht.
# Es erfordert zusätzliche Setup-Schritte und GitHub Actions Secrets.
#
# Um dieses Workflow zu aktivieren:
# 1. Entferne die .example Endung von diesem Dateinamen
# 2. Konfiguriere die notwendigen Secrets in GitHub
# 3. Passe die Build-Parameter nach Bedarf an

name: Build Android APK

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]
  workflow_dispatch: # Ermöglicht manuellen Workflow-Start

jobs:
  build:
    runs-on: ubuntu-latest
    
    steps:
    - name: Checkout Repository
      uses: actions/checkout@v4

    - name: Setup Node.js
      uses: actions/setup-node@v4
      with:
        node-version: '18'
        cache: 'npm'

    - name: Setup JDK 17
      uses: actions/setup-java@v4
      with:
        distribution: 'temurin'
        java-version: '17'
        cache: 'gradle'

    - name: Install Dependencies
      run: npm ci

    - name: Prepare Web Files
      run: |
        mkdir -p www
        cp *.html *.js *.css *.png www/ 2>/dev/null || true

    - name: Sync Capacitor
      run: npm run sync

    - name: Grant Execute Permission for Gradlew
      run: chmod +x android/gradlew

    - name: Build Debug APK
      run: cd android && ./gradlew assembleDebug --no-daemon --stacktrace

    - name: Upload APK Artifact
      uses: actions/upload-artifact@v4
      with:
        name: app-debug
        path: android/app/build/outputs/apk/debug/app-debug.apk
        retention-days: 30

    - name: Create Release (optional)
      if: github.ref == 'refs/heads/main' && github.event_name == 'push'
      uses: softprops/action-gh-release@v1
      with:
        tag_name: v1.0.${{ github.run_number }}
        name: Release v1.0.${{ github.run_number }}
        files: android/app/build/outputs/apk/debug/app-debug.apk
      env:
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

  # Optional: Build Release APK (signiert)
  build-release:
    runs-on: ubuntu-latest
    if: github.ref == 'refs/heads/main' && github.event_name == 'push'
    
    steps:
    - name: Checkout Repository
      uses: actions/checkout@v4

    - name: Setup Node.js
      uses: actions/setup-node@v4
      with:
        node-version: '18'

    - name: Setup JDK 17
      uses: actions/setup-java@v4
      with:
        distribution: 'temurin'
        java-version: '17'

    - name: Install Dependencies
      run: npm ci

    - name: Prepare Web Files
      run: |
        mkdir -p www
        cp *.html *.js *.css *.png www/ 2>/dev/null || true

    - name: Sync Capacitor
      run: npm run sync

    # Keystore Setup (erfordert GitHub Secrets)
    - name: Setup Keystore
      run: |
        echo "${{ secrets.KEYSTORE_BASE64 }}" | base64 -d > my-release-key.keystore
        echo "MYAPP_RELEASE_STORE_FILE=../../my-release-key.keystore" >> android/gradle.properties
        echo "MYAPP_RELEASE_KEY_ALIAS=${{ secrets.KEY_ALIAS }}" >> android/gradle.properties
        echo "MYAPP_RELEASE_STORE_PASSWORD=${{ secrets.KEYSTORE_PASSWORD }}" >> android/gradle.properties
        echo "MYAPP_RELEASE_KEY_PASSWORD=${{ secrets.KEY_PASSWORD }}" >> android/gradle.properties

    - name: Build Release APK
      run: cd android && ./gradlew assembleRelease --no-daemon

    - name: Upload Release APK
      uses: actions/upload-artifact@v4
      with:
        name: app-release
        path: android/app/build/outputs/apk/release/app-release.apk
        retention-days: 90

# Notwendige GitHub Secrets für Release Build:
# - KEYSTORE_BASE64: Base64-kodierter Keystore (cat keystore.jks | base64)
# - KEY_ALIAS: Alias des Keys im Keystore
# - KEYSTORE_PASSWORD: Passwort für den Keystore
# - KEY_PASSWORD: Passwort für den Key
